---
import type { Props } from '@astrojs/starlight/props';
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import { ViewTransitions } from 'astro:transitions';

const props = Astro.props as Props;
---

<DefaultHead {...props} />
<ViewTransitions fallback="swap" />

<style is:global>
  /*
    View Transitions are used for their client-side navigation hooks, not for
    animation: page changes look like normal navigation, but the sidebar can be
    patched before the new page is painted.
  */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }
</style>

<script>
  // Keep the sidebar stable when moving between articles:
  // - the sidebar keeps its scroll position and the groups the user opened or closed
  // - coming from the front page, the chosen product (Vidi or GC2) is opened and the other collapsed
  interface AstroBeforeSwapEvent extends Event {
    from: URL;
    to: URL;
    newDocument: Document;
    swap: () => void;
  }

  const SIDEBAR_SELECTOR = '#starlight__sidebar';
  const DETAILS_SELECTOR = `${SIDEBAR_SELECTOR} details`;
  const PRODUCT_LABELS: Record<string, string> = { vidi: 'Vidi', gc2: 'GC2' };

  const base = import.meta.env.BASE_URL.replace(/\/$/, '');

  const getSection = (pathname: string) => {
    const path = base && pathname.startsWith(base) ? pathname.slice(base.length) : pathname;
    return path.split('/').filter(Boolean)[0] ?? '';
  };

  const getProductGroups = (doc: Document) =>
    Array.from(
      doc.querySelectorAll<HTMLDetailsElement>(`${SIDEBAR_SELECTOR} ul.top-level > li > details`),
      (details) => ({
        label: details.querySelector(':scope > summary .group-label span')?.textContent?.trim(),
        details,
      })
    );

  // Open the chosen product and collapse everything in the others
  const focusProduct = (doc: Document, section: string) => {
    getProductGroups(doc).forEach(({ label, details }) => {
      if (label === PRODUCT_LABELS[section]) {
        details.open = true;
      } else if (Object.values(PRODUCT_LABELS).includes(label ?? '')) {
        details.open = false;
        details.querySelectorAll('details').forEach((nested) => (nested.open = false));
      }
    });
  };

  // The sidebar has the same structure on every page, so the open state can be copied by index
  const applyDetailsState = (doc: Document, state: boolean[]) => {
    doc.querySelectorAll<HTMLDetailsElement>(DETAILS_SELECTOR).forEach((details, index) => {
      details.open = state[index] ?? details.open;
    });
  };

  // Always show the current page, even if its group was collapsed
  const openCurrentPage = (doc: Document) => {
    let element = doc.querySelector(`${SIDEBAR_SELECTOR} [aria-current="page"]`)?.parentElement;
    while (element) {
      if (element instanceof HTMLDetailsElement) element.open = true;
      element = element.parentElement;
    }
  };

  document.addEventListener('astro:before-swap', (event) => {
    const transition = event as AstroBeforeSwapEvent;
    const sidebar = document.querySelector<HTMLElement>(SIDEBAR_SELECTOR);
    const fromSection = getSection(transition.from.pathname);
    const toSection = getSection(transition.to.pathname);
    const fromFrontPage = !sidebar && fromSection === '';

    if (!sidebar && !(fromFrontPage && toSection in PRODUCT_LABELS)) return;

    const scrollTop = sidebar?.scrollTop ?? 0;
    const detailsState = Array.from(
      document.querySelectorAll<HTMLDetailsElement>(DETAILS_SELECTOR),
      (details) => details.open
    );
    const defaultSwap = transition.swap;

    transition.swap = () => {
      if (fromFrontPage) {
        focusProduct(transition.newDocument, toSection);
      } else {
        applyDetailsState(transition.newDocument, detailsState);
        openCurrentPage(transition.newDocument);
      }

      defaultSwap();

      if (!fromFrontPage) {
        const newSidebar = document.querySelector<HTMLElement>(SIDEBAR_SELECTOR);
        if (newSidebar) newSidebar.scrollTop = scrollTop;
      }
    };
  });
</script>

<script>
  type ImageZoomDialogElements = {
    dialog: HTMLDialogElement;
    image: HTMLImageElement;
    caption: HTMLElement;
    link: HTMLAnchorElement;
  };

  let imageZoomDialogElements: ImageZoomDialogElements | undefined;

  const IMAGE_SELECTOR = '.sl-markdown-content img';
  const DIALOG_ID = 'image-zoom-dialog';
  const EXCLUDE_SELECTOR = 'a, button, [data-image-zoom-exclude]';

  const getZoomableImage = (target: EventTarget | null) => {
    if (!(target instanceof Element)) return null;

    const image = target.closest<HTMLImageElement>(IMAGE_SELECTOR);

    if (!image || image.closest(EXCLUDE_SELECTOR)) return null;
    if (!image.currentSrc && !image.src) return null;

    return image;
  };

  const getDialogElements = () => {
    if (imageZoomDialogElements?.dialog.isConnected) return imageZoomDialogElements;

    document.getElementById(DIALOG_ID)?.remove();

    const dialog = document.createElement('dialog');
    dialog.id = DIALOG_ID;
    dialog.className = 'image-zoom-dialog';
    dialog.innerHTML = `
      <div class="image-zoom-dialog__content">
        <button type="button" class="image-zoom-dialog__close" aria-label="Luk billedvisning"></button>
        <img class="image-zoom-dialog__image" alt="" />
        <div class="image-zoom-dialog__footer">
          <p class="image-zoom-dialog__caption"></p>
          <a class="image-zoom-dialog__link" target="_blank" rel="noopener">Åbn original</a>
        </div>
      </div>
    `;

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelector('.image-zoom-dialog__close')?.addEventListener('click', () => {
      dialog.close();
    });

    document.body.append(dialog);

    const image = dialog.querySelector<HTMLImageElement>('.image-zoom-dialog__image');
    const caption = dialog.querySelector<HTMLElement>('.image-zoom-dialog__caption');
    const link = dialog.querySelector<HTMLAnchorElement>('.image-zoom-dialog__link');

    if (!image || !caption || !link) {
      throw new Error('Image zoom dialog markup is missing expected elements.');
    }

    imageZoomDialogElements = { dialog, image, caption, link };
    return imageZoomDialogElements;
  };

  const getImageCaption = (image: HTMLImageElement) => {
    const figureCaption = image.closest('figure')?.querySelector('figcaption')?.textContent?.trim();
    return figureCaption || image.title || image.alt || '';
  };

  const openImageZoom = (sourceImage: HTMLImageElement) => {
    const { dialog, image, caption, link } = getDialogElements();
    const imageUrl = sourceImage.currentSrc || sourceImage.src;
    const imageCaption = getImageCaption(sourceImage);

    image.src = imageUrl;
    image.alt = sourceImage.alt || imageCaption;
    caption.textContent = imageCaption;
    caption.hidden = !imageCaption;
    link.href = imageUrl;

    if (!dialog.open) dialog.showModal();
  };

  const initializeImageZoom = () => {
    document.querySelectorAll<HTMLImageElement>(IMAGE_SELECTOR).forEach((image) => {
      if (image.closest(EXCLUDE_SELECTOR)) return;
      if (!image.currentSrc && !image.src) return;

      image.classList.add('image-zoomable');

      if (!image.hasAttribute('tabindex')) image.tabIndex = 0;
      if (!image.hasAttribute('role')) image.setAttribute('role', 'button');
      if (!image.hasAttribute('aria-label')) {
        const label = image.alt
          ? `Vis billede i stor størrelse: ${image.alt}`
          : 'Vis billede i stor størrelse';

        image.setAttribute('aria-label', label);
      }
    });
  };

  document.addEventListener('click', (event) => {
    const image = getZoomableImage(event.target);
    if (!image) return;

    event.preventDefault();
    openImageZoom(image);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;

    const image = getZoomableImage(event.target);
    if (!image) return;

    event.preventDefault();
    openImageZoom(image);
  });

  document.addEventListener('astro:page-load', initializeImageZoom);
  initializeImageZoom();
</script>
